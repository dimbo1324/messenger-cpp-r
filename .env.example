# Development-only example values. Do not commit a real .env file.

CHAT_DB_CONN=host=localhost port=5432 dbname=messenger_dev user=messenger_app password=messenger_dev_password
CHAT_SERVER_PORT=8080
CHAT_DB_POOL_SIZE=4
CHAT_MAX_CLIENTS=64
CHAT_READ_TIMEOUT_SEC=300
CHAT_MAX_FRAME_SIZE=65536
CHAT_LOG_PATH=logs/user_activity.log

# GUI uses these credentials to authenticate before admin commands.
# Create an admin user locally before using the real GUI mode.
CHAT_GUI_HOST=127.0.0.1
CHAT_GUI_PORT=8080
CHAT_GUI_ADMIN_LOGIN=admin
CHAT_GUI_ADMIN_PASSWORD=ChangeMe12345

# TLS config placeholders. Full TLS transport is not implemented in this pass.
CHAT_ENABLE_TLS=0
CHAT_TLS_CERT=
CHAT_TLS_KEY=
